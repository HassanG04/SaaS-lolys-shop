{
  "name": "lolys-accessories-home",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run check:ui-build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "roadmap": "node scripts/roadmap.mjs",
    "roadmap:next": "node scripts/roadmap.mjs next",
    "roadmap:check": "node scripts/roadmap.mjs check",
    "test:tooling": "node --test scripts/*.test.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run && npm run test:tooling",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:ui-build": "node scripts/check-ui-build.mjs",
    "verify": "npm run check:migrations && npm run check:tokens && npm run lint && npm run format:check && npm run typecheck && npm run test:unit && npm run build && npm run check:secrets && npm run check:bundle",
    "test:e2e": "node scripts/pending.mjs test:e2e",
    "db:start": "node scripts/pending.mjs db:start",
    "db:stop": "node scripts/pending.mjs db:stop",
    "db:reset": "node scripts/pending.mjs db:reset",
    "db:test": "node scripts/pending.mjs db:test",
    "db:types": "node scripts/pending.mjs db:types",
    "db:test:concurrency": "node scripts/pending.mjs db:test:concurrency",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:i18n": "node scripts/pending.mjs check:i18n",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:sql": "node scripts/pending.mjs check:sql",
    "analytics:install": "node scripts/pending.mjs analytics:install",
    "analytics:test": "node scripts/pending.mjs analytics:test",
    "analytics:forecast": "node scripts/pending.mjs analytics:forecast",
    "test:unit:coverage": "vitest run --coverage && npm run test:tooling"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": "24.x",
    "npm": ">=11 <12"
  }
}
